    <!-- First-run walkthrough -->
    <string name="walk_welcome_title">欢迎使用 Brainwave</string>
    <string name="walk_welcome_text">Brainwave 利用 Muse 头带的信号，展示你的专注和平静如何变化。除非你录制，否则不会保存任何内容。</string>
    <string name="walk_mind_title">心智</string>
    <string name="walk_mind_text">这三张卡片分别显示专注、平静和困倦。每个仪表盘随分数变化而移动。下方的图表显示最近十分钟。</string>
    <string name="walk_headband_title">连接你的头带</string>
    <string name="walk_headband_text">点按顶部的“头带”来查找你的 Muse。还没有头带？可在同一屏幕试用演示。</string>
    <string name="walk_calm_title">平静</string>
    <string name="walk_calm_text">点按“平静”开始缓慢呼吸。吸气时莲花绽放，呼气时合拢。可在设置中选择柔和的声音。</string>
    <string name="walk_menu_title">菜单</string>
    <string name="walk_menu_text">点按脑形按钮打开菜单。选择“比较”可查看大脑两侧随时间的变化，选择“捕获”可查看已保存的录制。</string>
