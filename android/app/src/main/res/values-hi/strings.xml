    <!-- First-run walkthrough -->
    <string name="walk_welcome_title">Brainwave में आपका स्वागत है</string>
    <string name="walk_welcome_text">Brainwave दिखाता है कि आपका ध्यान और शांति कैसे बदलते हैं, Muse हेडबैंड के सिग्नलों से। आप रिकॉर्ड करें तभी कुछ सहेजा जाता है।</string>
    <string name="walk_mind_title">मन</string>
    <string name="walk_mind_text">ये तीन कार्ड फ़ोकस, शांति और नींद दिखाते हैं। हर गेज अपने स्कोर के साथ चलता है। नीचे का ग्राफ़ पिछले दस मिनट दिखाता है।</string>
    <string name="walk_headband_title">अपना हेडबैंड जोड़ें</string>
    <string name="walk_headband_text">अपना Muse खोजने के लिए ऊपर हेडबैंड दबाएं। अभी हेडबैंड नहीं है? उसी स्क्रीन से डेमो आज़माएं।</string>
    <string name="walk_calm_title">शांति</string>
    <string name="walk_calm_text">धीमी सांस शुरू करने के लिए शांति दबाएं। सांस लेने पर कमल खुलता है और छोड़ने पर बंद होता है। सेटिंग्स में कोई नरम ध्वनि चुनें।</string>
    <string name="walk_menu_title">मेनू</string>
    <string name="walk_menu_text">मेनू खोलने के लिए ब्रेन बटन दबाएं। समय के साथ मस्तिष्क के दोनों हिस्से देखने के लिए तुलना चुनें, या सहेजी गई रिकॉर्डिंग के लिए कैप्चर।</string>
