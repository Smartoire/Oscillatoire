    <!-- First-run walkthrough -->
    <string name="walk_welcome_title">Welcome to Brainwave</string>
    <string name="walk_welcome_text">Brainwave shows how your attention and calm change, using the signals from a Muse headband. Nothing is saved unless you record it.</string>
    <string name="walk_mind_title">Mind</string>
    <string name="walk_mind_text">These three cards show Focus, Calm and Sleepiness. Each gauge moves as its score changes. The graph below shows the last ten minutes.</string>
    <string name="walk_headband_title">Connect your headband</string>
    <string name="walk_headband_text">Tap Headband at the top to find your Muse. No headband yet? Try the demo from the same screen.</string>
    <string name="walk_calm_title">Calm</string>
    <string name="walk_calm_text">Tap Calm to start slow breathing. The lotus opens as you breathe in and closes as you breathe out. Choose a soft sound in Settings.</string>
    <string name="walk_menu_title">The menu</string>
    <string name="walk_menu_text">Tap the brain button to open the menu. Choose Compare to see the two sides of the brain over time, or Captures for saved recordings.</string>
