    "Let the breath slow down. The sound will soften until you settle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع تنفسك يتباطأ. سيخفت الصوت حتى تستقر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie den Atem langsamer werden. Der Ton wird leiser, bis Sie zur Ruhe kommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que la respiración se calme. El sonido se suavizará hasta que te relajes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازه دهید نفس آرام شود. صدا تا آرام شدنتان نرم‌تر می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez votre respiration ralentir. Le son s'adoucira jusqu'à ce que vous vous calmiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साँस को धीमा होने दें। आपके शांत होने तक आवाज़ नरम होती जाएगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸をゆっくりにしてください。落ち着くまで音は穏やかになります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je adem vertragen. Het geluid wordt zachter tot je rustig bent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте дыханию замедлиться. Звук будет смягчаться, пока вы не успокоитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让呼吸慢下来。声音会逐渐变柔和，直到你平静下来。"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاتح"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hell"
          }
        },
        "es": {
          "stringUnit": {
