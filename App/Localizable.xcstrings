    "Start unlocks when all four sensors touch the skin and you're holding still.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتاح البدء عندما تلامس المستشعرات الأربعة الجلد وتكون ساكناً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start wird freigeschaltet, wenn alle vier Sensoren die Haut berühren und Sie ruhig sitzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar se activa cuando los cuatro sensores tocan la piel y estás quieto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع وقتی فعال می‌شود که هر چهار سنسور به پوست بچسبند و شما بی‌حرکت باشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer se débloque quand les quatre capteurs touchent la peau et que vous restez immobile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब चारों सेंसर त्वचा को छुएँ और आप स्थिर हों, तब शुरू करें सक्रिय होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4 つのセンサーすべてが肌に触れ、じっとしていると開始できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start wordt beschikbaar als alle vier sensoren de huid raken en je stil zit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Начать» станет доступно, когда все четыре датчика коснутся кожи и вы не двигаетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当四个传感器都贴住皮肤且你保持静止时，即可开始。"
          }
        }
      }
    },
