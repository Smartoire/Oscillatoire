    "Planning, decisions and speech production. Linked with positive, approach-oriented mood.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخطيط واتخاذ القرار وإنتاج الكلام. مرتبط بحالة مزاجية إيجابية تميل إلى الإقدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planung, Entscheidungen und Sprachproduktion. Verbunden mit positiver, annähernder Stimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planificación, decisiones y producción del habla. Relacionado con un estado de ánimo positivo y de acercamiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ریزی، تصمیم‌گیری و تولید گفتار. با حال مثبت و رویکردگرا مرتبط است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planification, décisions et production de la parole. Lié à une humeur positive, tournée vers l'action."
          }
