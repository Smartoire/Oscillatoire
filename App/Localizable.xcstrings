        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना, निर्णय और बोलने का उत्पादन। सकारात्मक, आगे बढ़ने वाले मूड से जुड़ा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
