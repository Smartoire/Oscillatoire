    "Standard is six breaths a minute. Slow is five, quick is seven and a half.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العادي ست أنفاس في الدقيقة. البطيء خمس، والسريع سبعة ونصف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard sind sechs Atemzüge pro Minute. Langsam sind fünf, schnell sieben einhalb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar son seis respiraciones por minuto. Lento, cinco; rápido, siete y medio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استاندارد یعنی شش نفس در دقیقه. آهسته یعنی پنج و سریع یعنی هفت و نیم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard correspond à six respirations par minute. Lent : cinq, rapide : sept et demi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य का मतलब है प्रति मिनट छह साँसें। धीमा पाँच, तेज़ साढ़े सात।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準は 1 分間に 6 回の呼吸です。ゆっくりは 5 回、速いは 7.5 回です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard is zes ademhalingen per minuut. Langzaam is vijf, snel is zeven en een half."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарт — шесть вдохов в минуту. Медленный — пять, быстрый — семь с половиной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准为每分钟六次呼吸，慢为五次，快为七次半。"
          }
        }
      }
    },
