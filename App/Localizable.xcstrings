    "No captures yet. Press Record at the top to capture a time window.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تسجيلات بعد. اضغط على تسجيل في الأعلى لالتقاط نافذة زمنية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Aufnahmen. Tippen Sie oben auf Aufnehmen, um ein Zeitfenster festzuhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay capturas. Pulsa Grabar arriba para capturar un intervalo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز ضبطی نیست. بالای صفحه ضبط را بزنید تا یک بازه زمانی ذخیره شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune capture pour l'instant. Appuyez sur Enregistrer en haut pour capturer une période."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई कैप्चर नहीं है। समय अवधि कैप्चर करने के लिए ऊपर रिकॉर्ड दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだキャプチャはありません。上の「記録」を押して時間帯を取り込みます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen opnamen. Tik bovenaan op Opnemen om een tijdvak vast te leggen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей пока нет. Нажмите «Запись» вверху, чтобы сохранить отрезок времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有捕获。点按顶部的“录制”来捕获一段时间。"
          }
        }
      }
    },
