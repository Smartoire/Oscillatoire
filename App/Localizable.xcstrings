    "You are settling. The sound is filling out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستقر. يمتلئ الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommen zur Ruhe. Der Klang wird voller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te estás calmando. El sonido se llena."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال آرام شدن هستید. صدا پُرتر می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous apaisez. Le son se remplit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप शांत हो रहे हैं। आवाज़ और भरती जा रही है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち着いてきました。音がふくらんでいきます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je komt tot rust. Het geluid wordt voller."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы успокаиваетесь. Звук становится полнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在平静下来，声音也随之丰满。"
          }
        }
      }
    },
