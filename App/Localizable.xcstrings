    "Turn on your Muse and keep it close. Close the Muse app on your phone: a headband connects to one device at a time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Muse وأبقه قريباً. أغلق تطبيق Muse على هاتفك: تتصل العصابة بجهاز واحد في كل مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Ihr Muse ein und halten Sie es in der Nähe. Schließen Sie die Muse-App auf Ihrem Telefon: Ein Stirnband verbindet sich jeweils nur mit einem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende tu Muse y mantenlo cerca. Cierra la app de Muse en tu teléfono: una diadema solo se conecta a un dispositivo a la vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse را روشن کنید و نزدیک نگه دارید. برنامه Muse روی گوشی را ببندید: هر هدبند فقط به یک دستگاه وصل می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez votre Muse et gardez-le à proximité. Fermez l'application Muse sur votre téléphone : un bandeau ne se connecte qu'à un appareil à la fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse चालू करें और पास रखें। फ़ोन पर Muse ऐप बंद करें: हेडबैंड एक समय में केवल एक डिवाइस से जुड़ता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse の電源を入れ、近くに置いてください。スマートフォンの Muse アプリは閉じてください。ヘッドバンドは一度に 1 台の端末にしか接続できません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je Muse aan en houd hem dichtbij. Sluit de Muse-app op je telefoon: een hoofdband verbindt met één apparaat tegelijk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Muse и держите его рядом. Закройте приложение Muse на телефоне: повязка подключается только к одному устройству."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Muse 并让它靠近。关闭手机上的 Muse 应用：头带一次只能连接一台设备。"
          }
        }
      }
    },
