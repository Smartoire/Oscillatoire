        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld"
          }
        }
      }
    },
    "%@ activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشاط %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Aktivität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فعالیت %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activité %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ गतिविधि।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のアクティビティ。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-activiteit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активность: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 活动。"
          }
        }
      }
    },
    "%@ and %@ are about equally active.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ و%@ نشطان بالقدر نفسه تقريباً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %@ sind etwa gleich aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@ están casi igual de activos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ و %@ تقریباً به یک اندازه فعال هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et %@ sont à peu près aussi actifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ और %@ लगभग समान रूप से सक्रिय हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ と %@ はほぼ同じくらい活発です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ zijn ongeveer even actief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ и %@ примерно одинаково активны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 与 %@ 的活跃程度大致相当。"
          }
        }
      }
    },
    "%@ disconnected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع اتصال %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha desconectado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ قطع شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'est déconnecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ डिस्कनेक्ट हो गया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の接続が切れました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is verbroken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отключён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开。"
          }
        }
      }
    },
    "%@ eased over the session, by about %lld points.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفض %@ خلال الجلسة بنحو %lld نقطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sank während der Sitzung um etwa %lld Punkte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bajó durante la sesión, unos %lld puntos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در طول جلسه حدود %lld امتیاز کاهش یافت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a diminué au cours de la séance, d'environ %lld points."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सत्र के दौरान लगभग %lld अंक घटा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はセッション中に約 %lld ポイント下がりました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ daalde tijdens de sessie met ongeveer %lld punten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ снизился за сеанс примерно на %lld баллов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在本次记录中下降了约 %lld 分。"
          }
        }
      }
    },
    "%@ held about steady over the session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقي %@ مستقراً تقريباً خلال الجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blieb während der Sitzung etwa stabil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se mantuvo bastante estable durante la sesión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در طول جلسه تقریباً ثابت ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est resté à peu près stable au cours de la séance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सत्र के दौरान लगभग स्थिर रहा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はセッション中ほぼ安定していました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bleef tijdens de sessie ongeveer stabiel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ оставался примерно стабильным за сеанс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在本次记录中基本保持稳定。"
          }
        }
      }
    },
    "%@ is a little more active than %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ أكثر نشاطاً قليلاً من %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist etwas aktiver als %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está un poco más activo que %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کمی فعال‌تر از %@ است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un peu plus actif que %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , %@ से थोड़ा अधिक सक्रिय है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ よりやや活発です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is iets actiever dan %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ немного активнее, чем %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 比 %@ 略活跃。"
          }
        }
      }
    },
    "%@ is much more active than %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ أكثر نشاطاً بكثير من %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist deutlich aktiver als %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está mucho más activo que %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ خیلی فعال‌تر از %@ است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est beaucoup plus actif que %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , %@ से कहीं अधिक सक्रिय है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ よりずっと活発です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is veel actiever dan %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ намного активнее, чем %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 比 %@ 活跃得多。"
          }
        }
      }
    },
    "%@ needs a firmware update. Update it in the Muse app first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يحتاج إلى تحديث البرنامج الثابت. حدّثه أولاً من تطبيق Muse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ benötigt ein Firmware-Update. Aktualisieren Sie es zuerst in der Muse-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita una actualización de firmware. Actualízala primero en la app de Muse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ به به‌روزرسانی سیستم‌افزار نیاز دارد. ابتدا آن را در برنامه Muse به‌روز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nécessite une mise à jour du micrologiciel. Mettez-la à jour d'abord dans l'application Muse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को फ़र्मवेयर अपडेट चाहिए। पहले Muse ऐप में अपडेट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはファームウェアの更新が必要です。先に Muse アプリで更新してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft een firmware-update nodig. Werk die eerst bij in de Muse-app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нужно обновление прошивки. Сначала обновите её в приложении Muse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要固件更新。请先在 Muse 应用中更新。"
          }
        }
      }
    },
    "%@ needs a licence from Interaxon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يحتاج إلى ترخيص من Interaxon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ benötigt eine Lizenz von Interaxon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita una licencia de Interaxon."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ به مجوز از Interaxon نیاز دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a besoin d'une licence d'Interaxon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को Interaxon से लाइसेंस चाहिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には Interaxon のライセンスが必要です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft een licentie van Interaxon nodig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нужна лицензия от Interaxon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要来自 Interaxon 的许可。"
          }
        }
      }
    },
    "%@ over the last %lld minutes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ خلال آخر %lld دقيقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den letzten %lld Minuten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en los últimos %lld minutos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در %lld دقیقه گذشته"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur les %lld dernières minutes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पिछले %lld मिनट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の過去 %lld 分間"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de afgelopen %lld minuten"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ за последние %lld мин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 过去 %lld 分钟"
          }
        }
      }
    },
    "%@ rose over the session, by about %lld points.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفع %@ خلال الجلسة بنحو %lld نقطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stieg während der Sitzung um etwa %lld Punkte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ subió durante la sesión, unos %lld puntos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در طول جلسه حدود %lld امتیاز افزایش یافت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a augmenté au cours de la séance, d'environ %lld points."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सत्र के दौरान लगभग %lld अंक बढ़ा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はセッション中に約 %lld ポイント上がりました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steeg tijdens de sessie met ongeveer %lld punten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вырос за сеанс примерно на %lld баллов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在本次记录中上升了约 %lld 分。"
          }
        }
      }
    },
    "%@ was the more active one %lld%% of the time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان %@ الأكثر نشاطاً في %lld٪ من الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war zu %lld %% der Zeit der aktivere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fue el más activo el %lld %% del tiempo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در %lld٪ مواقع فعال‌تر بود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ était le plus actif %lld %% du temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld%% समय अधिक सक्रिय रहा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のほうが %lld%% の時間で活発でした。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was %lld%% van de tijd de actievere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ был активнее в %lld %% времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 %lld%% 的时间里更活跃。"
          }
        }
      }
    },
