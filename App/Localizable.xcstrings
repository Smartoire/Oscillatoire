    "It is removed from this device and cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف من هذا الجهاز ولا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird von diesem Gerät entfernt und kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de este dispositivo y no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از این دستگاه حذف می‌شود و قابل بازگشت نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est supprimée de cet appareil et ne peut pas être restaurée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस से हट जाएगा और इसे वापस नहीं लाया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末から削除され、元に戻せません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt van dit apparaat verwijderd en kan niet ongedaan worden gemaakt."
          }
        },
