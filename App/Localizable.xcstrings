    "Otherwise %@ was higher or level. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وإلا كان %@ أعلى أو متساوياً. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst lag %@ höher oder gleichauf. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De otro modo, %@ estuvo más alto o igual. %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در غیر این صورت %@ بالاتر یا برابر بود. %@"
