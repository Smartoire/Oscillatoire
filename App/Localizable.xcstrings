    "On average %@ was a little ahead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المتوسط كان %@ متقدماً قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Durchschnitt lag %@ etwas vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En promedio, %@ estuvo un poco por delante."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌طور میانگین %@ کمی جلوتر بود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, %@ était un peu en avance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "औसतन %@ थोड़ा आगे रहा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均すると %@ がやや優勢でした。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddeld lag %@ er iets voor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В среднем %@ немного опережал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，%@ 略占优势。"
          }
        }
      }
    },
    "On average %@ was clearly ahead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المتوسط كان %@ متقدماً بوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Durchschnitt lag %@ deutlich vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En promedio, %@ estuvo claramente por delante."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌طور میانگین %@ به‌وضوح جلوتر بود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, %@ était nettement en avance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "औसतन %@ साफ़ तौर पर आगे रहा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均すると %@ が明らかに優勢でした。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddeld lag %@ duidelijk voor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В среднем %@ заметно опережал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，%@ 明显占优势。"
          }
        }
      }
    },
    "On average the two were about level.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المتوسط كان الاثنان متساويين تقريباً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Durchschnitt waren beide etwa gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En promedio, los dos estuvieron más o menos igualados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌طور میانگین این دو تقریباً برابر بودند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, les deux étaient à peu près au même niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "औसतन दोनों लगभग बराबर थे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均すると両者はほぼ同じでした。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddeld waren de twee ongeveer gelijk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В среднем они были примерно на одном уровне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，两者大致持平。"
          }
