    "Show the introduction again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض المقدمة مرة أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einführung erneut anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la introducción de nuevo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش دوباره معرفی"
          }
        },
