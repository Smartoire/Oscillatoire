    "Learning your usual level. Keep breathing with the circle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تعلّم مستواك المعتاد. تنفّس مع الدائرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr üblicher Pegel wird gelernt. Atmen Sie weiter mit dem Kreis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendiendo tu nivel habitual. Sigue respirando con el círculo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال یادگیری سطح معمول شما. با دایره نفس بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprentissage de votre niveau habituel. Continuez à respirer avec le cercle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सामान्य स्तर सीखा जा रहा है। गोले के साथ साँस लेते रहें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものレベルを学習中です。円に合わせて呼吸を続けてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gebruikelijke niveau leren. Blijf ademen met de cirkel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучаем ваш обычный уровень. Дышите вместе с кругом."
