    "Balance %lld: your focus and calm together. A rough everyday measure, not a health score.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوازن %lld: تركيزك وهدوؤك معاً. مقياس تقريبي للحياة اليومية، وليس درجة صحية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance %lld: Ihre Konzentration und Ruhe zusammen. Ein grobes Alltagsmaß, kein Gesundheitswert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio %lld: tu concentración y calma juntas. Una medida aproximada del día a día, no una puntuación de salud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعادل %lld: تمرکز و آرامش شما با هم. یک سنجه تقریبی روزمره، نه امتیاز سلامت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibre %lld : votre concentration et votre calme ensemble. Une mesure approximative du quotidien, pas un score de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संतुलन %lld: आपका फ़ोकस और शांति मिलाकर। रोज़मर्रा का मोटा माप, स्वास्थ्य स्कोर नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バランス %lld：集中と落ち着きの総合値です。日常の大まかな目安で、健康スコアではありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans %lld: je focus en kalmte samen. Een ruwe maat voor het dagelijks leven, geen gezondheidsscore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %lld: ваша концентрация и спокойствие вместе. Грубая бытовая мера, а не показатель здоровья."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡 %lld：你的专注与平静的综合。这是粗略的日常衡量，并非健康评分。"
          }
        }
      }
    },
