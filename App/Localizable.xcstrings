    "Connect a headband, or try the demo, to compare areas over time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صل عصابة رأس أو جرّب العرض التوضيحي لمقارنة المناطق عبر الزمن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie ein Stirnband oder testen Sie die Demo, um Bereiche über die Zeit zu vergleichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una diadema o prueba la demo para comparar áreas a lo largo del tiempo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک هدبند وصل کنید یا نسخه نمایشی را امتحان کنید تا ناحیه‌ها را در طول زمان مقایسه کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un bandeau ou essayez la démo pour comparer les zones au fil du temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ क्षेत्रों की तुलना के लिए एक हेडबैंड कनेक्ट करें या डेमो आज़माएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドバンドを接続するか、デモを試して、時間の経過に伴う領域を比較しましょう。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind een hoofdband of probeer de demo om gebieden in de tijd te vergelijken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите повязку или попробуйте демо, чтобы сравнивать области во времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接头带，或试用演示，以比较各区域随时间的变化。"
          }
        }
      }
    },
